import java.util.*;
public class c {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        while(t-->0) {
            int n=sc.nextInt();
            int k=sc.nextInt();
            int[] a=new int[n];
            for(int i=0;i<n;i++) a[i]=sc.nextInt();
            ArrayList<Integer> freq=new ArrayList<>();
            int count=1;
            for(int i=1;i<n;i++){
                if(a[i]==a[i-1]) count++;
                else{
                    freq.add(count);
                    count=1;
                }
            }
            freq.add(count);
            HashSet<Integer> vals = new HashSet<>();
            vals.add(0);

            for(int fr:freq) vals.add(fr);
            ArrayList<Integer> brood = new ArrayList<>(vals);
            Collections.sort(brood);
            int ans=0;
            for (int cut:brood) {
                long total=0;
                int groups=0;
                int smallest=Integer.MAX_VALUE;
                for (int x : freq) {
                    if (x > cut) {
                        int left = x - cut;
                        total += left;
                        groups++;
                        smallest = Math.min(smallest, left);
                    }
                }

                if (groups == 0) {
                    continue;
                }

                long need = k - total;

                if (need % groups != 0) {
                    continue;
                }

                long add = need / groups;

                if (smallest + add > 0) {
                    ans++;
                }
            }

            System.out.println(ans);
        }

        sc.close();
    }
}

